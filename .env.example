# ---------------------------------------------------------------------------
# Payload database
# ---------------------------------------------------------------------------
# Payload uses POSTGRES_URL when it is set, and falls back to the SQLite file
# otherwise (see the `db` block in src/payload.config.ts). Unsetting
# POSTGRES_URL is therefore the way back to SQLite.

# SQLite — the local fallback.
DATABASE_URL=file:./intranet.db

# Supabase Postgres. Use the *session* pooler on port 5432: the transaction
# pooler (6543) has no prepared-statement support, which Drizzle requires, and
# the direct db.<ref>.supabase.co host is IPv6-only without the paid IPv4
# add-on. Find it under Project Settings → Database → Connection string.
#POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ---------------------------------------------------------------------------
# Auth.js — Google Workspace SSO
# ---------------------------------------------------------------------------
# Sign-in is restricted to the Workspace domains in ALLOWED_DOMAINS
# (src/auth.config.ts). Production uses the deployed origin here.
AUTH_URL=http://localhost:3000
AUTH_SECRET=YOUR_SECRET_HERE
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---------------------------------------------------------------------------
# Supabase — the old Departure project (migration source only)
# ---------------------------------------------------------------------------
# Pre-Departure used to live in its own project. Its tables now sit in the
# `pre_departure` schema of the intranet project above, and no application code
# reads these any more — only scripts/pre-departure-copy.mjs, which copies from
# the old project to the new one. Safe to delete once you are happy the move is
# complete and you no longer need to re-run that script.
NEXT_PUBLIC_SUPABASE_URL=https://<old-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# The module is gated to local development in src/middleware.ts. Set this to
# `true` at build time to reach it from a production build.
#PRE_DEPARTURE_ENABLED=true

# ---------------------------------------------------------------------------
# Seat Scanner — external MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ---------------------------------------------------------------------------
# Sabre — Pre-Departure PNR retrieval
# ---------------------------------------------------------------------------
LEGACY_PRE_BASE_URL=
SOAP_STAGING_URL=
SOAP_STAGING_USERNAME=
SOAP_STAGING_PASSWORD=
SOAP_STAGING_PCC=
JSON_STAGING_URL=

# Google service account, used for the Sheets import
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
